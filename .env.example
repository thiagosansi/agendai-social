# Local Postgres. Default here is the native Homebrew Postgres on port 5432
# (no Docker required); use a dedicated `agendai_social` database, distinct
# from the `agendatmstudio` product's own database on the same server.
# Alternative: `pnpm db:up` starts a docker-compose Postgres on port 5433
# instead (see docker-compose.yml) if you prefer an isolated container.
DATABASE_URL="postgresql://thiagosantossilva@localhost:5432/agendai_social?schema=public"

# Shared password gate for the approval web UI (single-owner tool, no
# multi-user auth needed yet).
APP_PASSWORD=""

# Bearer token the AI generation routine sends when calling the
# draft-creation API.
GENERATION_API_TOKEN="dev-token-change-me"

# Bearer token the analysis routine sends when calling POST /api/analysis.
# GET /api/analysis/latest also accepts GENERATION_API_TOKEN.
ANALYSIS_API_TOKEN="dev-token-change-me"

# Shared secret the daily publish cron must present to trigger a run.
CRON_SECRET=""

# Instagram Graph API — Business account used to publish approved pieces.
META_IG_USER_ID=""
META_IG_TOKEN=""
META_TOKEN_EXPIRES_AT=""

# Vercel Blob — stores the approved piece images before publish.
BLOB_READ_WRITE_TOKEN=""

# Web Push — notifica no celular quando há peças para aprovar ou uma
# publicação falhou. Gere o par uma vez com `npx web-push generate-vapid-keys`.
# Sem estas variáveis o app funciona normalmente, apenas sem notificações.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"

# Geração automática de imagens das peças (Cloudflare Workers AI, camada gratuita
# de 10k neurons/dia, ou fal.ai). Sem as credenciais do provider selecionado a
# feature fica desligada e o upload manual continua funcionando. Token
# Cloudflare: dashboard → My Profile → API Tokens → template "Workers AI".
#
# Modelo padrão é o klein-9b (melhor qualidade no comparativo), mas a cota
# gratuita de 10k neurons/dia só rende ~7 imagens/dia nele. Em vez de falhar
# quando a cota acaba, o adapter cai automaticamente para o klein-4b (bem mais
# barato em neurons) na mesma geração — tudo ainda dentro da camada gratuita.
IMAGE_PROVIDER="cloudflare" # cloudflare | fal
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_IMAGE_MODEL="@cf/black-forest-labs/flux-2-klein-9b"
# Fallback automático quando CLOUDFLARE_IMAGE_MODEL fica sem cota/capacidade
# (429, 5xx/timeout persistente, ou erro de quota do Workers AI). Deixe vazio
# ("") para desligar o fallback. Sem esta env, o adapter já usa o klein-4b
# como fallback automaticamente quando o modelo principal é o klein-9b.
CLOUDFLARE_IMAGE_FALLBACK_MODEL="@cf/black-forest-labs/flux-2-klein-4b"

# fal.ai — usado quando IMAGE_PROVIDER=fal, e por qualquer candidato fal em
# `pnpm image-gen:compare` independente do IMAGE_PROVIDER ativo. Chave em
# fal.ai/dashboard/keys.
FAL_KEY=""
FAL_IMAGE_MODEL="fal-ai/z-image/turbo"
