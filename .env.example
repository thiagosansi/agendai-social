# Local Postgres. Default here is the native Homebrew Postgres on port 5432
# (no Docker required); use a dedicated `agendai_social` database, distinct
# from the `agendatmstudio` product's own database on the same server.
# Alternative: `pnpm db:up` starts a docker-compose Postgres on port 5433
# instead (see docker-compose.yml) if you prefer an isolated container.
DATABASE_URL="postgresql://thiagosantossilva@localhost:5432/agendai_social?schema=public"

# Shared password gate for the approval web UI (single-owner tool, no
# multi-user auth needed yet).
APP_PASSWORD=""

# Bearer token the AI generation routine sends when calling the
# draft-creation API.
GENERATION_API_TOKEN="dev-token-change-me"

# Bearer token the analysis routine sends when calling POST /api/analysis.
# GET /api/analysis/latest also accepts GENERATION_API_TOKEN.
ANALYSIS_API_TOKEN="dev-token-change-me"

# Shared secret the daily publish cron must present to trigger a run.
CRON_SECRET=""

# Instagram Graph API — Business account used to publish approved pieces.
META_IG_USER_ID=""
META_IG_TOKEN=""
META_TOKEN_EXPIRES_AT=""

# Vercel Blob — stores the approved piece images before publish.
BLOB_READ_WRITE_TOKEN=""

# Web Push — notifica no celular quando há peças para aprovar ou uma
# publicação falhou. Gere o par uma vez com `npx web-push generate-vapid-keys`.
# Sem estas variáveis o app funciona normalmente, apenas sem notificações.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"
