// Prisma schema for Agendaí Social Studio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A single Instagram content piece, following the lifecycle described in
// README.md and docs/02-playbook-conteudo.md: draft -> approved -> published
// (or failed). `pillar` and `segment` are free-form strings keyed to the
// editorial contract in docs/02-playbook-conteudo.md §2 (content pillars a-f
// and the segment rotation) rather than enums, since that rotation is
// expected to evolve without a schema migration.
model Piece {
  id      String @id @default(cuid())
  pillar  String
  segment String

  format      PieceFormat
  caption     String
  imagePrompt String

  // Uploaded by the founder during approval (POST/DELETE
  // /api/pieces/[id]/image, or POST .../video for reels/stories video);
  // never writable directly through POST/PATCH. Ordered by sortOrder —
  // index 0 is used as the "cover" media everywhere a single thumbnail is
  // needed (fila list, /publicados). `estatico`/`carrossel` hold images
  // only (2-10 for carrossel, see lib/validation.ts); `reels` holds exactly
  // 1 video; `stories` holds exactly 1 image OR 1 video (kind="video").
  // Media is mutable only while status=draft — once approved it's frozen so
  // the queued publish always ships what was reviewed.
  images PieceImage[]

  publishAt DateTime
  status    PieceStatus @default(draft)

  // Set only by the daily publish cron (a later task) after a successful
  // Instagram Graph API call.
  igMediaId   String?
  igPermalink String?
  metrics     Json?

  claimCheckPassed Boolean @default(false)
  lastError        String?

  // Set while a reels/story video container is still processing on Meta's
  // side when the publish cron's per-run time budget (lib/cron-publish.ts's
  // RUN_BUDGET_MS) runs out — status stays `approved` (not `failed`) and the
  // next cron run resumes by polling this container instead of creating a
  // new one. Cleared (both fields set back to null) as soon as the container
  // reaches FINISHED (then published) or ERROR/EXPIRED (then failed).
  pendingContainerId        String?
  pendingContainerCreatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishAt])
  @@index([pillar, segment, format, publishAt])
}

enum PieceFormat {
  carrossel
  reels
  estatico
  stories
}

enum PieceStatus {
  draft
  approved
  published
  failed
}

// One uploaded media item belonging to a Piece, ordered by sortOrder
// (0-based, contiguous — POST/DELETE /api/pieces/[id]/image resequence on
// every mutation). url is either a Vercel Blob URL or a local /uploads/...
// path (see app/api/pieces/[id]/image/route.ts and .../video/route.ts).
//
// `kind` distinguishes "image" (default, unchanged v1 behavior) from
// "video" (reels/stories only — see lib/validation.ts's VIDEO_FORMATS).
// `contentType`/`durationSec` are set for video rows (MIME type and
// duration in seconds, the latter supplied by the client since deriving it
// server-side would require a media-probing dependency this app doesn't
// have). `coverUrl` is an optional still-image thumbnail for a video row,
// uploaded separately via POST .../video/cover — when absent, Meta derives
// a cover automatically from the video itself.
model PieceImage {
  id          String   @id @default(cuid())
  pieceId     String
  piece       Piece    @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  url         String
  sortOrder   Int
  kind        String   @default("image") // "image" | "video"
  contentType String?
  durationSec Int?
  coverUrl    String?
  createdAt   DateTime @default(now())

  @@index([pieceId, sortOrder])
}

// One row per weekly insights cron run (app/api/cron/insights/route.ts) —
// tracks the IG Business account's follower count over time so
// GET /api/report/latest can render a followersTrend. `metrics` is reserved
// for future account-level insight fields (e.g. profile_views) beyond
// followers_count; unused today.
model AccountSnapshot {
  id             String   @id @default(cuid())
  capturedAt     DateTime @default(now())
  followersCount Int
  metrics        Json?

  @@index([capturedAt])
}

// One Web Push subscription — i.e. one browser/device that opted in to
// notifications on the Config page (POST /api/push/subscribe). This is a
// single-owner app (see middleware.ts), so there is no user relation: every
// row is one of the founder's devices and every notification fans out to all
// of them.
//
// `endpoint` is the push service URL the browser hands us and is globally
// unique per subscription, which makes it the natural upsert key — re-opting
// in from the same device refreshes the keys instead of creating duplicates.
// `p256dh`/`auth` are the client's encryption keys, required by the Web Push
// payload encryption scheme.
//
// Rows are pruned automatically when the push service reports the
// subscription is gone (404/410) — see lib/push.ts.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per analysis report — a periodic (or on-demand) AI-generated
// review of recent performance, written via POST /api/analysis and read via
// GET /api/analysis/latest. `insights`/`recommendations` are structured JSON
// (validated shapes live in lib/validation.ts's createAnalysisReportSchema)
// so the generation routine can consume them programmatically, while
// `summaryMarkdown` carries the same analysis as prose for display.
// `source` distinguishes a routine (scheduled) run from a manual/ad-hoc one;
// `schemaVersion` lets the insights/recommendations JSON shape evolve later
// without a migration.
model AnalysisReport {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  periodStart     DateTime
  periodEnd       DateTime
  summaryMarkdown String
  insights        Json
  recommendations Json
  // schemaVersion 2 only — ready-to-review content proposals derived from
  // insights.market (see lib/validation.ts's contentProposalSchema). Absent
  // (null) on v1 reports.
  contentProposals Json?
  source          String   @default("routine")
  schemaVersion   Int      @default(1)

  @@index([createdAt])
}

// Generic key/value settings row, read/written through lib/settings.ts.
// Boolean keys ("generationPaused", "publishingPaused", "forceNextGeneration")
// are stored as the string "true"/"false" — an absent row means "false", so
// the kill switches default to off without a seed. "generationIntervalWeeks"
// is a plain string int ("1".."4"), defaulting to "1" (weekly) when absent.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// A non-owner account, managed on /config by the owner. The owner itself
// is NOT a row here — it authenticates as username "admin" directly
// against APP_PASSWORD (see lib/session.ts), since this is fundamentally a
// single-owner tool (middleware.ts) that gained secondary, restricted
// roles. `role` is "viewer" (read-only, see lib/session.ts SessionRole) or
// "approver" (full piece workflow — edit caption/prompt, upload/remove/
// reorder images, approve/disapprove — but no Config, no manual round, no
// settings/push/users API; lib/session.ts requirePieceEditor). `passwordHash`
// is produced by lib/passwords.ts (scrypt, Node-only). `active` is a
// soft-disable switch — deactivating an account (rather than deleting the
// row) keeps its history/audit trail while immediately blocking new logins
// and forcing out any existing session (app/layout.tsx re-checks `active`
// on every request).
model ViewerUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("viewer") // "viewer" | "approver"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One row per market scan run (GET /api/analysis/market) — an app-mediated
// Instagram Business Discovery + hashtag-search snapshot for the
// competitors/hashtags configured on /config, since the (cloud-scheduled)
// monthly analysis routine never holds META_IG_TOKEN. `competitors` and
// `hashtags` carry the sanitized/claim-checked scan results (see
// lib/market-scan.ts), `errors` carries per-item failures (private
// account, hashtag not found, rate limit) that didn't abort the rest of
// the scan. `hashtagsQueried` records only the hashtags Graph was actually
// called for (skipped-by-quota tags are excluded) — GET /api/analysis/market
// sums this across the last 7 days to enforce the 25-unique-hashtag safety
// limit under Meta's 30/7-day cap.
model MarketSnapshot {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  competitors     Json
  hashtags        Json
  hashtagsQueried String[]
  errors          Json

  @@index([createdAt])
}
