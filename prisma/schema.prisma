// Prisma schema for Agendaí Social Studio.
// Models (Piece, etc.) are added in a later task — this is the empty
// baseline so `prisma migrate dev` and `prisma generate` work from day one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
